<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose Laravel application files when the repository is in public_html.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|\.git|\.claude)(?:/|$) - [F,L,NC]

    # Serve Laravel's public assets and front controller from the project root.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

DirectoryIndex index.php